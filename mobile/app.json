{
  "expo": {
    "name": "MaarifaBooks",
    "slug": "maarifabooks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "maarifabooks",
    "ios": {
      "bundleIdentifier": "com.maarifabooks.app",
      "supportsTablet": false,
      "buildNumber": "1"
    },
    "android": {
      "package": "com.maarifabooks.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "allowBackup": false
    },
    "splash": {
      "backgroundColor": "#071B36",
      "resizeMode": "contain"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "owner": "lumbwadigitals-team",
    "extra": {
      "eas": {
        "projectId": "74e04001-4c03-43b5-91d3-c35a44816c4e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
