NEXT_PUBLIC_SUPABASE_URL=https://qsbyvztxrlnpujjakrfh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# PostHog browser analytics (project token is public; keep it in Vercel env vars)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Session Replay is enabled only in Production; leave false for Preview/local environments.
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false

# eHub SMS (server-side only; sender ID is the approved sender UUID)
EHUB_API_KEY=YOUR_EHUB_API_KEY
EHUB_API_SECRET=YOUR_EHUB_API_SECRET
EHUB_SENDER_ID=YOUR_APPROVED_SENDER_UUID
